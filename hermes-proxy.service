[Unit]
Description=Hermes subscription proxy (Nous Portal)
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/features/subscription-proxy
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

# GANTI ketiganya sesuai user login kamu — user ini yang menjalankan
# `hermes portal`, karena token OAuth tersimpan di home miliknya.
User=GANTI_USER
WorkingDirectory=/home/GANTI_USER
Environment=HOME=/home/GANTI_USER

# GANTI dengan hasil `which hermes`. Installer biasanya menaruhnya
# di ~/.local/bin/hermes, bukan /usr/local/bin.
ExecStart=/home/GANTI_USER/.local/bin/hermes proxy start --host 127.0.0.1 --port 8645

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-proxy

# ProtectHome sengaja TIDAK dipakai — proxy perlu membaca
# token OAuth di ~/.hermes/auth.json
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
